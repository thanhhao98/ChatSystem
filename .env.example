# Sao chép thành .env (đã bị .gitignore) và điền giá trị THẬT trên hạ tầng tham chiếu. KHÔNG commit .env.
# Thực tập sinh không có quyền truy cập SGOD trực tiếp; các biến SGOD_* chỉ dùng trên hạ tầng tham chiếu.

# --- SGOD gateway (docs/sgod-api-reference.md §1) ---
SGOD_BASE_URL=http://<sgod-gateway-host>:<port>
SGOD_AUTH_API_KEY=<SGOD_AUTH_API_KEY>
SGOD_ASSET_API_KEY=<SGOD_ASSET_API_KEY>
SGOD_CHAT_API_KEY=<SGOD_CHAT_API_KEY>

# --- GPT baseline qua gateway tương thích OpenAI (predict_toolcall --backend openai; các bước LLM của datagen/) ---
OPENAI_API_KEY=<your-openai-compatible-key>
OPENAI_BASE_URL=https://<openai-compatible-gateway>/v1
OPENAI_MODEL=<gpt-model-id-as-served-by-the-gateway>

# --- SLM qua vLLM (training/serve_vllm.sh; docs/serving.md) ---
SLM_BASE_URL=http://localhost:8000/v1
SLM_MODEL=<served-model-name>

# --- Hugging Face (chỉ cần cho dataset/model gated; trên Colab/Kaggle dùng Secrets, không dùng .env) ---
HF_TOKEN=<hf_token>
